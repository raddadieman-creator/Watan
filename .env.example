# انسخي هذا الملف إلى .env.local للتطوير المحلي، أو أضيفي المتغيرات في Vercel:
# Project → Settings → Environment Variables
# لا تضعي أي مفتاح سري في ملف يُرفع إلى GitHub.

# الرابط العام للمنصة بعد النشر (يُستخدم في خريطة الموقع ووسوم المشاركة).
# اختياري: إن تُرك فارغًا يُستخدم VERCEL_PROJECT_PRODUCTION_URL الذي يوفّره Vercel تلقائيًا.
NEXT_PUBLIC_SITE_URL=

# ── متغيرات مستقبلية (غير مستخدمة في المرحلة الحالية) ──
# ستُضاف عند بناء لوحة الإدارة وقاعدة البيانات (المرحلة الخامسة):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # سري — في Vercel فقط، لا يبدأ بـ NEXT_PUBLIC_

# ── عدّاد الزوار (اختياري) ──
# تُضاف تلقائيًا عند ربط Upstash for Redis من Vercel → Storage.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
