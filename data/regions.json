    "lead": "تمتد من ساحل البحر الأحمر غربًا إلى أطراف نجد شرقًا. فيها المسجد النبوي ومسجد قباء، وفي محافظة العلا أول موقع سعودي سُجّل في قائمة التراث العالمي.",
    "sections": [
      {
        "key": "geography",
        "title": "الموقع والتضاريس",
        "items": [
          {
            "text": "تقع في غرب المملكة، وتحدها مكة المكرمة من الجنوب، وتبوك من الشمال، والرياض والقصيم وحائل من الشرق، والبحر الأحمر من الغرب.",
            "sources": [
              "saudipedia-provinces"
            ]
          },
          {
            "text": "لها ساحل على البحر الأحمر بطول نحو 200 كم.",
            "sources": [
              "saudipedia-provinces"
            ]
          }
        ]
      },
      {
        "key": "climate",
        "title": "المناخ",
        "items": [
          {
            "text": "مناخ صحراوي جاف: صيف حار وشتاء بارد، وربيع وخريف معتدلان. المناطق الساحلية أشد حرارة ورطوبة في الصيف.",
            "sources": [
              "saudipedia-provinces"
            ]
          },
          {
            "text": "تنخفض الصغرى شتاءً إلى نحو 10°م، وتصل العظمى صيفًا إلى نحو 45°م.",
            "sources": [
              "saudipedia-provinces"
            ]
          }
        ]
      },
      {
        "key": "heritage",
        "title": "التراث والمعالم",
        "items": [
          {
            "text": "المسجد النبوي ومسجد قباء في مدينة المدينة المنورة.",
            "sources": [
              "saudipedia-provinces"
            ]
          },
          {
            "text": "موقع الحِجر الأثري (مدائن صالح) في العلا مسجل في قائمة التراث العالمي لليونسكو منذ 2008.",
            "sources": [
              "unesco-whc-sa"
            ]
          },
          {
            "text": "قصر الفريد من أبرز معالم العلا.",
            "sources": [
              "saudipedia-provinces"
            ]
          }
        ]
      },
      {
        "key": "economy",
        "title": "الاقتصاد",
        "items": [
          {
            "text": "منجم مهد الذهب أكبر مناجم الذهب في المملكة وأقدمها.",
            "sources": [
              "saudipedia-provinces"
            ]
          },
          {
            "text": "للسياحة الثقافية والأثرية وزن خاص في المنطقة، ولا سيما في العلا.",
            "sources": [
              "saudipedia-provinces"
            ]
          }
        ]
      }
    ]
