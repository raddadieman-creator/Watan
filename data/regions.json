  {
    "id": "asir",
    "nameAr": "منطقة عسير",
    "shortAr": "عسير",
    "nameEn": "Asir",
    "seatAr": "مدينة أبها",
    "seat": [42.5, 18.23],
    "accent": "#5C6E3A",
    "population": { "value": 2024285, "source": "gastat-census-2022" },
    "areaKm2": { "value": 81000, "approx": true, "source": "saudipedia-provinces" },
    "governorates": {
      "count": 18,
      "names": ["خميس مشيط", "بيشة", "النماص", "محايل", "سراة عبيدة", "تثليث", "رجال ألمع", "بلقرن", "أحد رفيدة", "ظهران الجنوب", "المجاردة", "تنومة", "طريب", "البرك", "بارق", "الأمواه", "الفرشة"],
      "namesNote": "المصدر يذكر ثماني عشرة محافظة ويسرد سبع عشرة؛ الاسم الناقص بحاجة للتحقق.",
      "source": "saudipedia-provinces"
    },
    "detailLevel": "full",
    "lead": "منطقة جبلية في جنوب غرب المملكة، فيها نحو 29% من جبال المملكة، وتهبط من قمم السروات إلى ساحل البحر الأحمر. في بيوتها نشأ فن القط العسيري المسجل لدى اليونسكو.",
    "sections": [
      {
        "key": "geography",
        "title": "الموقع والتضاريس",
        "items": [
          { "text": "تقع جنوب منطقة الرياض وغرب نجران وشمال جازان وشرقها وجنوب مكة المكرمة، ولها ساحل على البحر الأحمر بطول 140 كم.", "sources": ["saudipedia-provinces"] },
          { "text": "تضم نحو 29% من جبال المملكة، مع أخاديد وعرة وطرق جبلية. تغطي الحرّات 3.75% من مساحتها، وتخترقها ثمانية أودية.", "sources": ["saudipedia-provinces"] },
          { "text": "يبلغ ارتفاع جبل السودة غرب أبها 3,015 مترًا وفق المصدر.", "sources": ["saudipedia-provinces"] }
        ]
      },
      {
        "key": "climate",
        "title": "المناخ",
        "items": [
          { "text": "معتدل صيفًا؛ لا تتجاوز الحرارة في أغسطس 25°م وفق المصدر، والشتاء بارد نسبيًا. تكثر الأمطار والعواصف في المرتفعات بتأثير الرياح الموسمية.", "sources": ["saudipedia-provinces"], "flag": "climate-normals-pending" }
        ]
      },
      {
        "key": "heritage",
        "title": "التراث والمعالم",
        "items": [
          { "text": "القط العسيري، فن زخرفة الجدران الداخلية الذي تمارسه النساء، مدرج في القائمة التمثيلية للتراث الثقافي غير المادي لدى اليونسكو منذ 2017.", "sources": ["unesco-ich-sa"] },
          { "text": "قرية المفتاحة في أبها، وفيها مركز الملك فهد الثقافي ومسرح طلال مداح.", "sources": ["saudipedia-provinces"] },
          { "text": "قرية رجال ألمع التاريخية، وتضم ثماني قلاع.", "sources": ["saudipedia-provinces"] }
        ]
      },
      {
        "key": "development",
        "title": "التنمية والمشروعات",
        "items": [
          { "text": "من المشروعات المعلنة: شركة السودة للتطوير، واستراتيجية تطوير منطقة عسير، ومشروع وادي أبها، وقمم السودة. حالة الإنجاز بحاجة للتحقق من الجهات المنفذة.", "sources": ["saudipedia-provinces"], "flag": "status-pending" }
        ]
      }
    ],
    "universities": [
      { "nameAr": "جامعة الملك خالد", "url": "https://kku.edu.sa", "type": "حكومية" }
    ],
