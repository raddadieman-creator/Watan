    "detailLevel": "full",
    "lead": "تمتد على ساحل البحر الأحمر غرب المملكة، وفيها المسجد الحرام والمشاعر المقدسة، ومحافظتا جدة والطائف.",
    "sections": [
      {
        "key": "geography",
        "title": "الموقع والتضاريس",
        "items": [
          {
            "text": "تقع غرب المملكة على ساحل البحر الأحمر، تحدها منطقة الرياض شرقًا، والمدينة المنورة شمالًا، وعسير والباحة جنوبًا.",
            "sources": [
              "sp-makkah"
            ]
          },
          {
            "text": "تقع ضمن تكوين الدرع العربي النوبي، وتشكّل الحرّات 16% من مساحتها، ويمتد ساحلها 610 كم.",
            "sources": [
              "sp-makkah"
            ]
          }
        ]
      },
      {
        "key": "climate",
        "title": "المناخ",
        "items": [
          {
            "text": "حارة صيفًا من يونيو إلى أغسطس، ويبلغ متوسط الحرارة السنوي نحو 31 درجة، والطائف أبرد محافظاتها وأغزرها مطرًا.",
            "sources": [
              "sp-makkah"
            ]
          }
        ]
      },
      {
        "key": "economy",
        "title": "الاقتصاد",
        "items": [
          {
            "text": "تسهم بنحو 13% من الناتج المحلي الإجمالي للمملكة، وتضم مدينة الملك عبدالله الاقتصادية وميناء جدة الإسلامي.",
            "sources": [
              "sp-makkah"
            ]
          }
        ]
      }
    ]
  },
